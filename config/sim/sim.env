# Sourced by scripts/container/sim_launch.sh on every `./stack sim`.
# HEADLESS is passed to ./stack instead (HEADLESS=0 for the Gazebo GUI).

# PX4 SITL vehicle model (make px4_sitl <model>)
PX4_MODEL=gz_x500

# UDP port the Micro XRCE-DDS Agent listens on
MICRO_XRCE_AGENT_PORT=8888

# PX4 parameters, applied at SITL startup: PX4_PARAM_<NAME>=<value>
# COM_RC_IN_MODE=4: no RC required, so offboard works without a joystick
PX4_PARAM_COM_RC_IN_MODE=4
